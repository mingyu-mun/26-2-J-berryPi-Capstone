    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.2"
        },
        "type": {
          "const": "system.status"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "live",
            "recorded",
