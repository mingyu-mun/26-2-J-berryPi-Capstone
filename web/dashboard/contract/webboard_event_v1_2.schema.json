                },
                "TirePressure_Warn": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x100 startBit=16 len=4, 타이어 공기압 경고. Unlisted/reserved codes are not evidence of a known state."
