    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.2"
        },
        "type": {
          "const": "can.telemetry"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "live",
            "recorded",
            "simulated",
            "unavailable"
          ]
        },
        "t_rel_s": {
          "type": "number",
          "minimum": 0
        },
        "payload": {
          "type": "object",
          "properties": {
            "speed_kmh": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 255
            },
            "steering_angle_deg": {
              "type": [
                "number",
                "null"
              ],
              "description": "CAN SAS_angleVal signed 16-bit raw*0.1 = steering wheel (handwheel) angle in degrees. 32767 raw is error and MUST map to null; direction convention is unspecified in workbook.",
              "minimum": -3276.8,
              "maximum": 3276.6
            },
            "steering_rate_deg_s": {
              "type": [
                "number",
                "null"
              ],
              "description": "Derived delta of valid handwheel angle over elapsed measurement time; not a directly provided CAN signal."
            },
            "accelerator_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100,
              "description": "Optional 0-100 normalization; source Factor=1, Offset=0, Unit blank. Do not populate until pedal raw-to-% rule is confirmed."
            },
            "brake_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100,
              "description": "Optional 0-100 normalization; source Factor=1, Offset=0, Unit blank. Do not populate until pedal raw-to-% rule is confirmed."
            },
            "baseline_coverage_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "deviation_status": {
              "enum": [
                "within_baseline",
                "outside_baseline",
                "unavailable"
              ]
            },
            "can_drowsy": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "rule_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "signal_map_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "road_wheel_angle_deg": {
              "type": [
                "number",
                "null"
              ],
              "description": "Derived (not measured) SAS steering wheel angle/15 according to source note assuming 15:1 ratio. Null if the assumption is inapplicable."
            },
            "accel_pedal_raw": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 254,
              "description": "0x371 Accel_Pedal_Pos unsigned 8 bit; workbook documented operating range 0..254. Source Factor=1."
            },
            "brake_pedal_raw": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 127,
              "description": "0x371 Brake_Pedal_Pos unsigned 8 bit; workbook documented operating range 0..127. Source Factor=1."
            },
            "signal_times_s": {
              "type": "object",
              "properties": {
                "speed": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "steering": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "accelerator": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "brake": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "speed",
                "steering",
                "accelerator",
                "brake"
              ],
              "additionalProperties": false,
              "description": "Actual measurement-relative timestamps for each primary CAN signal. Null when not acquired, not arrival time."
            },
            "status_codes": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "GearPosition": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x102 startBit=0 len=4, 기어위치. Unlisted/reserved codes are not evidence of a known state."
                },
                "LaneKeep": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Raw code/unsigned value from 0x102 startBit=7 len=1, 차선유지기능. Unlisted/reserved codes are not evidence of a known state."
                },
                "LTurnSig_Indi": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x101 startBit=32 len=4, 좌측 방향지시등. Unlisted/reserved codes are not evidence of a known state."
                },
                "RTurnSig_Indi": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x101 startBit=40 len=4, 우측 방향지시등. Unlisted/reserved codes are not evidence of a known state."
                },
                "FlDoor": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Raw code/unsigned value from 0x102 startBit=4 len=1, 운전석 도어. Unlisted/reserved codes are not evidence of a known state."
                },
                "FrDoor": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Raw code/unsigned value from 0x102 startBit=5 len=1, 동승석 도어. Unlisted/reserved codes are not evidence of a known state."
                },
                "TrunkState": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Raw code/unsigned value from 0x102 startBit=6 len=1, 트렁크 상태. Unlisted/reserved codes are not evidence of a known state."
                },
                "DrvSeatBelt_Warn": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x100 startBit=4 len=4, 운전석 안전벨트 경고. Unlisted/reserved codes are not evidence of a known state."
                },
                "ESC_Indi": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x101 startBit=16 len=4, ESC 작동 상태. Unlisted/reserved codes are not evidence of a known state."
                },
                "Careless_Warn": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x100 startBit=24 len=4, 운전자 부주의 경고. Unlisted/reserved codes are not evidence of a known state."
                },
                "LaneSafe_indi": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x101 startBit=28 len=4, 차선안전 표시. Unlisted/reserved codes are not evidence of a known state."
                },
                "LaneKeep_indi": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x101 startBit=24 len=4, 차선유지 표시. Unlisted/reserved codes are not evidence of a known state."
                },
                "DriveMode_Indi": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x101 startBit=12 len=4, 주행모드. Unlisted/reserved codes are not evidence of a known state."
                },
                "ReGenBrakeLevel": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 15,
                  "description": "Raw code/unsigned value from 0x102 startBit=52 len=4, 회생제동 단계. Unlisted/reserved codes are not evidence of a known state."
                },
                "HOD_Dir_Status": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 7,
                  "description": "Raw code/unsigned value from 0x208 startBit=80 len=3, 핸들 파지 상태. Unlisted/reserved codes are not evidence of a known state."
                },
                "tirepressureFL": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 63,
                  "description": "Raw code/unsigned value from 0x103 startBit=36 len=6, 좌측 타이어 공기압. Unlisted/reserved codes are not evidence of a known state."
                },
                "tirepressureFR": {
                  "type": [
                    "integer",
                    "null"
                  ],
