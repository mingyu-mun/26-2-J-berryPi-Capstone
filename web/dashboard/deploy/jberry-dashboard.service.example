[Unit]
Description=J_Berry PI driver dashboard
After=network.target

[Service]
# Change the username and all paths to match this Raspberry Pi.
User=pi
WorkingDirectory=/home/pi/berryPi-Capstone
ExecStart=/home/pi/berryPi-Capstone/.venv-web/bin/python scripts/run_dashboard.py --host 0.0.0.0 --port 8000 --mode live
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
